#version 460
#extension GL_GOOGLE_include_directive : require

#include "DescriptorCommon.hg"
#include "HelperFunctions.hg"
#include "VoxelTerrainCommon.hg"

layout(push_constant) uniform TriSortPushConstants
{
    uint  g_VertexSlabBase;
    uint  g_MaxTriangles;
} pc;

layout(set = 1, binding = 0) buffer McCounterBuffer { uint g_MCCounter[]; };
layout(set = 1, binding = 1) readonly buffer VertexPoolBuffer { VoxelVertex g_Vertices[]; };
layout(set = 1, binding = 2) buffer SortBinBuffer { uint g_SortBins[]; };
layout(set = 1, binding = 3) buffer OutSortedTripletBuffer { uint g_OutSortedTriplets[]; };
layout(set = 1, binding = 4) readonly buffer TripletBuffer { uint g_Triplets[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main()
{
    uint t = gl_GlobalInvocationID.x;

    uint totalTris = min(g_MCCounter[0], pc.g_MaxTriangles);
    if (t >= totalTris)
        return;

    uvec3 posQSum = uvec3(0u);
    for (uint k = 0u; k < 3u; ++k)
    {
        VoxelVertex v = g_Vertices[pc.g_VertexSlabBase + g_Triplets[t * 3u + k]];
        posQSum += uvec3(v.posXY >> 16u, v.posXY & 0xFFFFu, v.posZnormal >> 16u);
    }

    uint key = VoxelTriSortKey(posQSum);
    uint dst = atomicAdd(g_SortBins[key], 1u);
    if (dst >= totalTris) // tri binned differently than in Count: no slot left in the sorted range
        return;

    uint d = dst * 3u;
    g_OutSortedTriplets[d + 0u] = g_Triplets[t * 3u + 0u]; // page-relative vertex numbers, winding order kept
    g_OutSortedTriplets[d + 1u] = g_Triplets[t * 3u + 1u];
    g_OutSortedTriplets[d + 2u] = g_Triplets[t * 3u + 2u];
}

#version 460
#extension GL_GOOGLE_include_directive : require

#include "DescriptorCommon.hg"

layout(push_constant) uniform ExtractPushConstants
{
    uint  g_CellsPerAxis;   // C; volume dim = C + 1 + 2A
    uint  g_Apron;          // A apron texels per side
    float g_VoxelSizeMeter;
    uint  g_VertexSlabBase; // this chunk's base offset into the vertex pool (in vertices)
    uint  g_MaxTriangles;
    float g_GeomorphRadiusMeter;
    uint  g_MaxVertices;
} pc;

layout(set = 1, binding = 0) readonly buffer DensityFieldBuffer { float g_DensityField[]; };
layout(set = 1, binding = 1)          buffer McCounterBuffer    { uint  g_MCCounter[]; };
layout(set = 1, binding = 2)          buffer EdgeMapBuffer      { uint  g_EdgeMap[]; };
layout(set = 1, binding = 3)          buffer EdgeListBuffer     { uint  g_EdgeList[]; };

#include "VoxelTerrainCommon.hg"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
void main()
{
    uvec3 tID = gl_GlobalInvocationID;
    const uint C = pc.g_CellsPerAxis;
    if (tID.x > C || tID.y > C || tID.z > C)
        return;

    const uint dim = C + 1u + 2u * pc.g_Apron;

    uvec3 tx = tID + pc.g_Apron;
    float d0 = g_DensityField[FlatTexel(tx, dim)];
    float dx = g_DensityField[FlatTexel(tx + uvec3(1u, 0u, 0u), dim)];
    float dy = g_DensityField[FlatTexel(tx + uvec3(0u, 1u, 0u), dim)];
    float dz = g_DensityField[FlatTexel(tx + uvec3(0u, 0u, 1u), dim)];

    bool s0 = d0 < 0.0;
    bool sx = dx < 0.0;
    bool sy = dy < 0.0;
    bool sz = dz < 0.0;

    uint keyBase = FlatTexel(tID, C + 1u) * 3u;

    if (tID.x < C)
    {
        uint key = keyBase + 0u;
        uint vi  = INVALID_INDEX;
        if (s0 != sx) // active edge
        {
            vi = atomicAdd(g_MCCounter[2], 1u);
            if (vi < pc.g_MaxVertices)
                g_EdgeList[vi] = key;
            else
                vi = INVALID_INDEX;
        }
        g_EdgeMap[key] = vi;
    }

    if (tID.y < C)
    {
        uint key = keyBase + 1u;
        uint vi  = INVALID_INDEX;
        if (s0 != sy) // active edge
        {
            vi = atomicAdd(g_MCCounter[2], 1u);
            if (vi < pc.g_MaxVertices)
                g_EdgeList[vi] = key;
            else
                vi = INVALID_INDEX;
        }
        g_EdgeMap[key] = vi;
    }

    if (tID.z < C)
    {
        uint key = keyBase + 2u;
        uint vi  = INVALID_INDEX;
        if (s0 != sz) // active edge
        {
            vi = atomicAdd(g_MCCounter[2], 1u);
            if (vi < pc.g_MaxVertices)
                g_EdgeList[vi] = key;
            else
                vi = INVALID_INDEX;
        }
        g_EdgeMap[key] = vi;
    }
}

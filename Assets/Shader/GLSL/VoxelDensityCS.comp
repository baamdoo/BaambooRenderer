#version 460
#extension GL_GOOGLE_include_directive : require

#include "VoxelTerrainCommon.hg"

layout(set = 1, binding = 0, std140) uniform VoxelGenParamsUBO
{
    VoxelTerrainGenParams gp;
} g_VoxelGenParams;

layout(set = 1, binding = 1) writeonly buffer DensityBuffer
{
    float g_OutDensity[];
};

layout(set = 1, binding = 2) readonly buffer HeightTileBuffer
{
    float g_HeightTile[];
};

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
void main()
{
    VoxelTerrainGenParams gp = g_VoxelGenParams.gp;

    uint  dim = gp.samplesPerAxis + 2u * gp.apron; // C+1+2A
    uvec3 tID = gl_GlobalInvocationID;
    if (tID.x >= dim || tID.y >= dim || tID.z >= dim)
        return;

    vec3  posWS  = VoxelTexelToWorld(gp, tID);
    float height = g_HeightTile[FlatTexel(tID.xz, dim)];

    g_OutDensity[FlatTexel(tID, dim)] = VoxelTerrainDensityFromSurface(posWS.y, height);
}

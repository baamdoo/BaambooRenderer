#ifndef SURFACE_RESOLVE_HG
#define SURFACE_RESOLVE_HG

#include "VisibilityBuffer.hg"

#define MATCLASS_STANDARD 0u
#define MATCLASS_TERRAIN  1u


bool FindMaterialTexture(MaterialData material, uint semantic, out MaterialTextureData textureData)
{
    textureData.textureID = INVALID_INDEX;
    textureData.semantic  = semantic;
    textureData.channel   = MATERIAL_TEXTURE_CHANNEL_RGB;
    textureData.padding0  = 0u;

    if (material.textureOffset == INVALID_INDEX)
        return false;

    for (uint bindingIndex = 0u; bindingIndex < material.textureCount; ++bindingIndex)
    {
        MaterialTextureData candidate =
            g_MaterialTextures.materialTextures[material.textureOffset + bindingIndex];
        if (candidate.semantic == semantic)
        {
            textureData = candidate;
            return candidate.textureID != INVALID_INDEX;
        }
    }

    return false;
}

float SelectMaterialTextureChannel(vec4 texel, uint channel)
{
    if (channel == MATERIAL_TEXTURE_CHANNEL_G)
        return texel.g;
    if (channel == MATERIAL_TEXTURE_CHANNEL_B)
        return texel.b;
    if (channel == MATERIAL_TEXTURE_CHANNEL_A)
        return texel.a;
    return texel.r;
}

vec4 DecodeMaterialTextureSample(vec4 texel, uint channel)
{
    if (channel == MATERIAL_TEXTURE_CHANNEL_RGB || channel == MATERIAL_TEXTURE_CHANNEL_RGBA)
        return texel;

    float value = SelectMaterialTextureChannel(texel, channel);
    return vec4(value);
}

bool SampleMaterialTextureGrad(MaterialData material, uint semantic,
                               vec2 uv, vec2 ddxUV, vec2 ddyUV,
                               out vec4 sampleValue)
{
    MaterialTextureData textureData;
    if (!FindMaterialTexture(material, semantic, textureData))
    {
        sampleValue = vec4(1.0);
        return false;
    }

    vec4 texel = textureGrad(
        g_SceneTextures[nonuniformEXT(textureData.textureID)], uv, ddxUV, ddyUV);
    sampleValue = DecodeMaterialTextureSample(texel, textureData.channel);
    return true;
}


vec2 SignNotZero(vec2 v)
{
    return vec2(v.x >= 0.0 ? 1.0 : -1.0,
                v.y >= 0.0 ? 1.0 : -1.0);
}

float EdgeFunction(vec2 a, vec2 b, vec2 c)
{
    return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
}

vec2 OctEncode(vec3 n)
{
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    if (n.z < 0.0)
    {
        vec2 oldXY = n.xy;
        n.xy = (1.0 - abs(oldXY.yx)) * SignNotZero(oldXY);
    }

    return n.xy;
}
vec3 OctDecode(vec2 e)
{
    vec3  n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.xy -= t * SignNotZero(n.xy);

    return normalize(n);
}

vec3 Barycentrics(vec2 ndc, vec4 c0, vec4 c1, vec4 c2)
{
    vec2 ndc0 = c0.xy / c0.w;
    vec2 ndc1 = c1.xy / c1.w;
    vec2 ndc2 = c2.xy / c2.w;

    float totalArea = EdgeFunction(ndc0, ndc1, ndc2);
    if (abs(totalArea) < 1e-6)
        return vec3(1.0 / 3.0);

    float a = EdgeFunction(ndc, ndc1, ndc2) / totalArea;
    float b = EdgeFunction(ndc, ndc2, ndc0) / totalArea;
    float c = 1.0 - a - b;

    vec3 invZ = vec3(1.0 / c0.w, 1.0 / c1.w, 1.0 / c2.w);
    vec3 bary = vec3(a, b, c) * invZ;
    return bary / dot(bary, vec3(1.0)); // 1/Z = a/Z0 + b/Z1 + c/Z2
}

void UVGradient(vec2 ndc, vec2 invViewport,
                vec4 c0, vec4 c1, vec4 c2,
                vec2 uv0, vec2 uv1, vec2 uv2,
                out vec2 duvdx, out vec2 duvdy)
{
    vec3 bary   = Barycentrics(ndc, c0, c1, c2);
    vec3 barydx = Barycentrics(ndc + vec2(2.0 * invViewport.x, 0.0), c0, c1, c2);
    vec3 barydy = Barycentrics(ndc + vec2(0.0, 2.0 * invViewport.y), c0, c1, c2);

    vec2 uv   = bary.x * uv0   + bary.y * uv1   + bary.z * uv2;
    vec2 uvdx = barydx.x * uv0 + barydx.y * uv1 + barydx.z * uv2;
    vec2 uvdy = barydy.x * uv0 + barydy.y * uv1 + barydy.z * uv2;

    duvdx = uvdx - uv;
    duvdy = uvdy - uv;
}


struct VisTriangle
{
    vec3 position[3];
    vec2 uv[3];
    vec3 normal[3];
    vec4 tangent[3];
    mat4 mLocalToWorld;
    mat4 mWorldToLocal;
    uint materialID;
};

VisTriangle FetchVisTriangle(uint v0, uint v1)
{
    uint instanceID   = VisInstanceID(v0);
    uint lod          = VisLOD(v0);
    uint meshletIndex = VisMeshletIndex(v1);
    uint triLocal     = VisTriLocal(v1);

    InstanceData  inst = g_Instances[instanceID];
    MeshData      mesh = g_Meshes[inst.meshID];
    TransformData xf   = g_TransformBuffer.transforms[inst.transformID];
    Meshlet       m    = g_MeshletBuffer.meshlets[meshletIndex];
    MeshLOD       ml   = mesh.lods[lod];

    uint tPacked3  = g_MeshletTriangleBuffer.meshletTriangles[ml.mtOffset + m.triangleOffset + triLocal];
    uint locals[3] = uint[3](tPacked3 & 0xFFu, (tPacked3 >> 8) & 0xFFu, (tPacked3 >> 16) & 0xFFu);

    VisTriangle t;
    t.mLocalToWorld = xf.mLocalToWorld;
    t.mWorldToLocal = xf.mWorldToLocal;
    t.materialID   = inst.materialID;
    for (uint k = 0u; k < 3u; ++k)
    {
        uint vi   = mesh.vOffset + g_MeshletVertexBuffer.meshletVertices[ml.mvOffset + m.vertexOffset + locals[k]];
        Vertex vv = g_VertexBuffer.vertices[vi];
        t.position[k] = vec3(vv.posX, vv.posY, vv.posZ);
        t.uv[k]   = vec2(vv.u, vv.v);
        t.normal[k] = vec3(vv.normalX, vv.normalY, vv.normalZ);
        t.tangent[k] = vec4(vv.tangentX, vv.tangentY, vv.tangentZ, vv.tangentW);
    }
    return t;
}

struct ResolvedSurface
{
    vec3  N;
    float roughness;
    uint  matClass;
    vec3  baseColor;
    float metallic;
    vec3  posWS;     // perspective-correct interpolated world position (velocity resolve)
};

ResolvedSurface ResolveMeshSurface(uint v0, uint v1, vec2 pixelCenter, vec2 viewport)
{
    VisTriangle t = FetchVisTriangle(v0, v1);

    vec3 wpos[3];
    vec4 c[3];
    for (uint k = 0u; k < 3u; ++k)
    {
        vec4 wp = t.mLocalToWorld * vec4(t.position[k], 1.0);
        wpos[k] = wp.xyz;
        c[k] = g_Camera.mViewProj * wp;
    }

    vec2 ndc = (pixelCenter / viewport) * 2.0 - 1.0;
    // Vulkan: NO ndc.y flip — ApplyRhiNDC negates mProj[1][1], so clip-space y is already
    // down (matches pixel-space y-down). The HLSL copy DOES flip (D3D NDC is y-up).

    vec3 bary = Barycentrics(ndc, c[0], c[1], c[2]);

    vec2 uv = bary.x * t.uv[0] + bary.y * t.uv[1] + bary.z * t.uv[2];
    vec3 normal = bary.x * t.normal[0] + bary.y * t.normal[1] + bary.z * t.normal[2];
    vec3 tangent =
        bary.x * t.tangent[0].xyz +
        bary.y * t.tangent[1].xyz +
        bary.z * t.tangent[2].xyz;

    float tangentSign   = t.tangent[0].w < 0.0 ? -1.0 : 1.0;
    float transformSign = determinant(mat3(t.mLocalToWorld)) < 0.0 ? -1.0 : 1.0;
    float tangentSignWS = tangentSign * transformSign;

    mat3 normalTransform = transpose(mat3(t.mWorldToLocal));

    vec3 edge01          = t.position[1] - t.position[0];
    vec3 edge02          = t.position[2] - t.position[0];
    vec3 geometricNormal = cross(edge01, edge02);
    vec3 geometricNormalWS = normalTransform * geometricNormal;
    float geometricNormalWSLen2 = dot(geometricNormalWS, geometricNormalWS);
    geometricNormalWS = geometricNormalWSLen2 > EPSILON_MIN
        ? geometricNormalWS * inversesqrt(geometricNormalWSLen2)
        : vec3(0.0, 1.0, 0.0);

    vec3 shadingNormalWS = normalTransform * normal;
    float shadingNormalWSLen2 = dot(shadingNormalWS, shadingNormalWS);
    shadingNormalWS = shadingNormalWSLen2 > EPSILON_MIN
        ? shadingNormalWS * inversesqrt(shadingNormalWSLen2)
        : geometricNormalWS;
    if (dot(shadingNormalWS, geometricNormalWS) < 0.0)
        shadingNormalWS = -shadingNormalWS;

    vec3 tangentWS = mat3(t.mLocalToWorld) * tangent;
    tangentWS -= shadingNormalWS * dot(tangentWS, shadingNormalWS);
    float tangentWSLen2 = dot(tangentWS, tangentWS);
    if (tangentWSLen2 > EPSILON_MIN)
    {
        tangentWS *= inversesqrt(tangentWSLen2);
    }
    else
    {
        vec3 axis = abs(shadingNormalWS.z) < 0.999
            ? vec3(0.0, 0.0, 1.0)
            : vec3(1.0, 0.0, 0.0);
        tangentWS = normalize(cross(axis, shadingNormalWS));
    }

    vec2 ddxUV, ddyUV;
    UVGradient(ndc, 1.0 / viewport, c[0], c[1], c[2], t.uv[0], t.uv[1], t.uv[2], ddxUV, ddyUV);

    ResolvedSurface s;
    s.matClass  = MATCLASS_STANDARD;
    s.N         = shadingNormalWS;
    s.roughness = 1.0;
    s.baseColor = vec3(1.0);
    s.metallic  = 0.0;
    s.posWS     = bary.x * wpos[0] + bary.y * wpos[1] + bary.z * wpos[2];

    if (t.materialID != INVALID_INDEX)
    {
        MaterialData mat = g_MaterialBuffer.materials[t.materialID];

        vec3 albedo = vec3(mat.tintR, mat.tintG, mat.tintB);
        vec4 textureSample;
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_BASE_COLOR, uv, ddxUV, ddyUV, textureSample))
        {
            albedo *= textureSample.rgb;
        }

        float metallic  = mat.metallic;
        float roughness = mat.roughness;
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_METALLIC, uv, ddxUV, ddyUV, textureSample))
        {
            metallic *= textureSample.x;
        }
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_PERCEPTUAL_ROUGHNESS, uv, ddxUV, ddyUV, textureSample))
        {
            roughness *= textureSample.x;
        }

        // Tangent-space normal map
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_NORMAL, uv, ddxUV, ddyUV, textureSample))
        {
            vec3 normalTS = textureSample.xyz * 2.0 - 1.0;
            float normalTSLen2 = dot(normalTS, normalTS);
            if (normalTSLen2 > EPSILON_MIN)
            {
                normalTS *= inversesqrt(normalTSLen2);
                if (normalTS.z < 0.0)
                    normalTS = -normalTS;

                vec3 bitangentWS = tangentSignWS * cross(shadingNormalWS, tangentWS);
                mat3 TBN = mat3(tangentWS, bitangentWS, shadingNormalWS);
                shadingNormalWS = TBN * normalTS;
                if (dot(shadingNormalWS, geometricNormalWS) < 0.0)
                    shadingNormalWS = -shadingNormalWS;
            }
        }

        s.N         = shadingNormalWS;
        s.roughness = roughness;
        s.baseColor = albedo;
        s.metallic  = metallic;
    }
    return s;
}

// DEBUG: ONLY the perspective-correct barycentrics for a VisID
vec3 DebugVisBary(uint v0, uint v1, vec2 pixelCenter, vec2 viewport)
{
    VisTriangle t = FetchVisTriangle(v0, v1);

    vec4 c[3];
    for (uint k = 0u; k < 3u; ++k)
        c[k] = g_Camera.mViewProj * (t.mLocalToWorld * vec4(t.position[k], 1.0));
    vec2 ndc = (pixelCenter / viewport) * 2.0 - 1.0;

    return Barycentrics(ndc, c[0], c[1], c[2]);
}


struct ResolvedMaterial
{
    vec3  baseColor;
    float metallic;
    float ao;
    vec3  emissive;
    uint  materialID;
};

ResolvedMaterial ResolveMaterial(uint v0, uint v1, vec2 pixelCenter, vec2 viewport)
{
    VisTriangle t = FetchVisTriangle(v0, v1);

    vec4 c[3];
    for (uint k = 0u; k < 3u; ++k)
    {
        vec4 wp = t.mLocalToWorld * vec4(t.position[k], 1.0);
        c[k] = g_Camera.mViewProj * wp;
    }

    vec2 ndc  = (pixelCenter / viewport) * 2.0 - 1.0;
    vec3 bary = Barycentrics(ndc, c[0], c[1], c[2]);
    vec2 uv   = bary.x * t.uv[0] + bary.y * t.uv[1] + bary.z * t.uv[2];

    vec2 ddxUV, ddyUV;
    UVGradient(ndc, 1.0 / viewport, c[0], c[1], c[2], t.uv[0], t.uv[1], t.uv[2], ddxUV, ddyUV);

    // Defaults match GBufferPS's invalid-material early-out (all zero) for A/B parity.
    ResolvedMaterial m;
    m.baseColor  = vec3(0.0);
    m.metallic   = 0.0;
    m.ao         = 0.0;
    m.emissive   = vec3(0.0);
    m.materialID = t.materialID;

    if (t.materialID != INVALID_INDEX)
    {
        MaterialData mat = g_MaterialBuffer.materials[t.materialID];

        vec3 albedo = vec3(mat.tintR, mat.tintG, mat.tintB);
        vec4 textureSample;
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_BASE_COLOR, uv, ddxUV, ddyUV, textureSample))
        {
            albedo *= textureSample.rgb;
        }

        float metallic = mat.metallic;
        float ao       = 1.0;
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_METALLIC, uv, ddxUV, ddyUV, textureSample))
        {
            metallic *= textureSample.x;
        }
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_OCCLUSION, uv, ddxUV, ddyUV, textureSample))
        {
            ao *= textureSample.x;
        }

        vec3 emissive = vec3(mat.emissionColorR, mat.emissionColorG, mat.emissionColorB) *
            mat.emissivePower;
        if (SampleMaterialTextureGrad(
                mat, MATERIAL_TEXTURE_SEMANTIC_EMISSION, uv, ddxUV, ddyUV, textureSample))
        {
            emissive *= textureSample.rgb;
        }

        m.baseColor = albedo;
        m.metallic  = metallic;
        m.ao        = ao;
        m.emissive  = emissive;
    }
    return m;
}

#endif // SURFACE_RESOLVE_HG

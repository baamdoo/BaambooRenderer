#version 460
#extension GL_GOOGLE_include_directive : require

#include "DescriptorCommon.hg"

layout(push_constant) uniform McPushConstants
{
    uint  g_CellsPerAxis;   // C; volume dim = C + 1 + 2A
    uint  g_Apron;          // A apron texels per side
    float g_VoxelSizeMeter;
    uint  g_VertexSlabBase; // this chunk's base offset into the vertex pool (in vertices)
    uint  g_MaxTriangles;
    float g_GeomorphRadiusMeter;
    uint  g_MaxVertices;
} pc;

layout(set = 1, binding = 0) readonly buffer DensityFieldBuffer { float g_DensityField[]; };
layout(set = 1, binding = 1)          buffer McCounterBuffer    { uint  g_MCCounter[]; };
layout(set = 1, binding = 2) readonly buffer TriTableBuffer     { int   g_TriTable[]; };
layout(set = 1, binding = 3) readonly buffer EdgeMapBuffer      { uint  g_EdgeMap[]; };
layout(set = 1, binding = 4)          buffer TripletBuffer      { uint  g_Triplets[]; };

#include "VoxelTerrainCommon.hg"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
void main()
{
    uvec3 cell = gl_GlobalInvocationID;
    const uint C = pc.g_CellsPerAxis;
    if (cell.x >= C || cell.y >= C || cell.z >= C)
        return;

    const uint dim = C + 1u + 2u * pc.g_Apron;

    uint cubeIndex = 0u;
    for (uint i = 0u; i < 8u; ++i)
    {
        uvec3 tx = cell + kCornerOffset[i] + pc.g_Apron;
        if (g_DensityField[FlatTexel(tx, dim)] < 0.0)
            cubeIndex |= (1u << i); // solid corner sets the bit
    }

    if (cubeIndex == 0u || cubeIndex == 255u)
        return; // fully inside/outside -> no surface

    // triangle count = tri-table entries until the -1 terminator
    uint triCount = 0u;
    for (uint e = 0u; e < 15u; e += 3u)
    {
        if (g_TriTable[cubeIndex * 16u + e] < 0)
            break;
        ++triCount;
    }

    atomicAdd(g_MCCounter[1], 1u); // active-cell tally

    // Look up every triangle's 3 vertex numbers at the owner grid points of its edges
    uint nums[15];
    uint validMask  = 0u;
    uint validCount = 0u;
    for (uint t = 0u; t < 5u; ++t)
    {
        if (t < triCount)
        {
            int edges[3] = int[3](
                g_TriTable[cubeIndex * 16u + t * 3u + 0u],
                g_TriTable[cubeIndex * 16u + t * 3u + 2u],
                g_TriTable[cubeIndex * 16u + t * 3u + 1u]); // winding order: eA, eC, eB

            bool valid = true;
            for (uint k = 0u; k < 3u; ++k)
            {
                uvec3 eo    = kEdgeOwner[edges[k]]; // (owner corner, far corner, axis)
                uvec3 owner = cell + kCornerOffset[eo.x];
                uint  n     = g_EdgeMap[FlatTexel(owner, C + 1u) * 3u + eo.z];

                nums[t * 3u + k] = n;
                valid = valid && (n < pc.g_MaxVertices); // sentinel and vertex overflow both fail
            }
            if (valid)
            {
                validMask |= 1u << t;
                ++validCount;
            }
        }
    }

    uint baseTri = atomicAdd(g_MCCounter[0], validCount); // reserve only triangles whose 3 vertices exist

    // Pack the kept triangles contiguously from baseTri
    uint s = baseTri;
    for (uint t = 0u; t < 5u; ++t)
    {
        if (((validMask >> t) & 1u) != 0u)
        {
            if (s < pc.g_MaxTriangles)
            {
                g_Triplets[s * 3u + 0u] = nums[t * 3u + 0u];
                g_Triplets[s * 3u + 1u] = nums[t * 3u + 1u];
                g_Triplets[s * 3u + 2u] = nums[t * 3u + 2u];
            }
            ++s;
        }
    }
}

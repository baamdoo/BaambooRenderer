#pragma once

#define ROOT_CONSTANT_SPACE space100

// Every resource is reached through the descriptor heap, by a u32 index from the push block.
#define GetResource(index) ResourceDescriptorHeap[NonUniformResourceIndex(index)]

// Fixed samplers, picked by name. 
// D3D12: static samplers s0-s8. Vulkan: immutable samplers in set 1, bindings 0-8.
[[vk::binding(0, 1)]] SamplerState           g_LinearClampSampler      : register(s0);
[[vk::binding(1, 1)]] SamplerState           g_LinearWrapSampler       : register(s1);
[[vk::binding(2, 1)]] SamplerState           g_PointClampSampler       : register(s2);
[[vk::binding(3, 1)]] SamplerState           g_PointWrapSampler        : register(s3);
[[vk::binding(4, 1)]] SamplerState           g_TrilinearWrapSampler    : register(s4);
[[vk::binding(5, 1)]] SamplerState           g_AnisotropicWrapSampler  : register(s5);
[[vk::binding(6, 1)]] SamplerComparisonState g_CompareLessEqualSampler : register(s6);
[[vk::binding(7, 1)]] SamplerState           g_PointClampMinSampler    : register(s7);
[[vk::binding(8, 1)]] SamplerState           g_LinearClampMinSampler   : register(s8);

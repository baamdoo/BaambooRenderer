static const uint PT_MAX_DEPTH_LIMIT = 64u;

static const float PT_RAY_EPS = 1.0e-4;

static const uint PT_BSDF_PRINCIPLED = 5u;

static const uint PT_BSDF_FLAG_DIFFUSE      = 0x1u;
static const uint PT_BSDF_FLAG_GLOSSY       = 0x2u;
static const uint PT_BSDF_FLAG_TRANSMISSION = 0x4u;

static const float PT_LOBE_EPS = 1.0e-4;

static const float PT_MIN_ROUGHNESS_ALPHA    = 1.0e-3;
static const float PT_SMOOTH_ALPHA_THRESHOLD = 1.0e-4;

// What the path tracer reads besides its arguments; RayGen fills it once per dispatch
struct PathScene
{
    SceneBufferIndices buffers;
    CameraData         camera;

    uint   maxDepth;
    float3 sceneBoundsCenter;
    float  sceneBoundsRadius;

    StructuredBuffer< PrimaryRayMediumStackSeedData > primaryMediumSeed;
    StructuredBuffer< MaterialSlabData >              materialSlabs;
    StructuredBuffer< float >                         lightSelectionCDF;

    Texture2D< float4 >       environmentMap;
    StructuredBuffer< float > environmentDistribution; // row CDF (height entries), then one column CDF per row
    float3                    environmentRadiance;     // used when useEnvironmentMap is 0
    uint                      useEnvironmentMap;
    uint                      useEnvironmentSampling;
    uint                      environmentDistributionWidth;
    uint                      environmentDistributionHeight;

#if PT_VALIDATION
    RWStructuredBuffer< uint > validationStats;
#endif
};

// Bounded scene, vacuum exterior
float GetSceneRayLength(SceneBufferIndices buffers, float3 originWS, float3 sceneBoundsCenter, float sceneBoundsRadius)
{
    if (!all(isfinite(originWS)) || !all(isfinite(sceneBoundsCenter)) ||
        !isfinite(sceneBoundsRadius) || sceneBoundsRadius <= 0.0)
        return 0.0;

    float sceneDistance = length(originWS - sceneBoundsCenter) + sceneBoundsRadius;

    ByteAddressBuffer lights = GetResource(buffers.lights);
    const LightCounts counts = LoadLightCounts(lights);
    [loop]
    for (uint i = 0u; i < counts.numSpheres; ++i)
    {
        SphereLight light = LoadSphereLight(lights, i);
        if (all(isfinite(light.position)) && isfinite(light.radius) && light.radius > 0.0)
            sceneDistance = max(sceneDistance, length(originWS - light.position) + light.radius);
    }

    float coordinateScale = max(max(abs(originWS.x), max(abs(originWS.y), abs(originWS.z))), sceneDistance);
    float rayLength = sceneDistance + max(4.0 * PT_RAY_EPS, 1.0e-5 * coordinateScale);
    return isfinite(rayLength) ? rayLength : 0.0;
}

// Shader-local endpoint data; no payload or CPU/GPU record layout changes.
struct AnalyticSphereLightHit
{
    uint sphereIndex;
    float dist;
    float3 normal;
};

bool FindClosestAnalyticSphereLight(SceneBufferIndices buffers, RayDesc ray, out AnalyticSphereLightHit hit)
{
    hit = {};
    hit.sphereIndex = kInvalidIndex;
    hit.dist = ray.TMax;

    ByteAddressBuffer lights = GetResource(buffers.lights);
    const LightCounts counts = LoadLightCounts(lights);
    [loop]
    for (uint i = 0u; i < counts.numSpheres; ++i)
    {
        float distance;
        float3 normal;
        if (IntersectRaySphereLight(ray, LoadSphereLight(lights, i), distance, normal) &&
            (hit.sphereIndex == kInvalidIndex || distance < hit.dist))
        {
            hit.sphereIndex = i;
            hit.dist = distance;
            hit.normal = normal;
        }
    }
    return hit.sphereIndex != kInvalidIndex;
}

struct SurfacePayload
{
    float2 barycentrics;
    float  dist;
    uint   hitKind;

    uint instanceID;
    uint primitiveID;
};

struct SurfaceData
{
    float3 normal;
    float  dist;

    float3 geometricNormal;
    uint   hitKind;

    float4 tangent; // xyz: world-space tangent, w: authored tangent-frame handedness in world space.

    float2 uv;
    uint   instanceID;
    uint   primitiveID;

    float2 ddxUV;
    float2 ddyUV;
};

bool TryLoadPrimaryMediumState(PrimaryRayMediumStackSeedData seed, out MediumStack hostStack, out MediumStack airStack)
{
    hostStack.count = 0u;
    airStack.Initialize();
    if (seed.status != PRIMARY_RAY_MEDIUM_SEED_STATUS_VALID ||
        seed.count < 1u ||
        seed.count > MAX_MEDIUM_STACK_CAPACITY || seed.airCount > MAX_MEDIUM_STACK_CAPACITY)
    {
        return false;
    }

    [ForceUnroll]
    for (uint i = 0u; i < MAX_MEDIUM_STACK_CAPACITY; ++i)
    {
        if (i >= seed.count)
            break;

        PrimaryRayMediumSeedEntryData entry = seed.entries[i];
        if (!IsPathFinite(entry.ior) || entry.ior <= 0.0)
            return false;

        if (i == 0u)
        {
            if (entry.boundaryInstanceID != kInvalidIndex)
                return false;
        }
        else if (entry.boundaryInstanceID == kInvalidIndex || entry.mediumID == kInvalidIndex)
        {
            return false;
        }
    }

    [ForceUnroll]
    for (uint i = 0u; i < MAX_MEDIUM_STACK_CAPACITY; ++i)
    {
        if (i >= seed.count)
            break;

        hostStack.entries[i].boundaryInstanceID = seed.entries[i].boundaryInstanceID;
        hostStack.entries[i].medium.mediumID    = seed.entries[i].mediumID;
        hostStack.entries[i].medium.ior         = seed.entries[i].ior;
    }

    for (uint i = 0u; i < seed.airCount; ++i)
    {
        MediumEntry entry;
        entry.boundaryInstanceID = seed.airEntries[i].boundaryInstanceID;
        entry.medium.mediumID    = seed.airEntries[i].mediumID;
        entry.medium.ior         = seed.airEntries[i].ior;
        if (!IsPathFinite(entry.medium.ior) || entry.medium.ior <= 0.0 || !airStack.TryAdd(entry))
            return false;
    }

    hostStack.count = seed.count;
    return true;
}

// Pure (BSDF-less) boundary routing
bool TryCrossPureMediumBoundary(
    uint boundaryInstanceID,
    Medium boundaryMedium,
    uint mediumFlags,
    float NoW,
    inout MediumStack hostStack,
    inout MediumStack airStack)
{
    if (hostStack.count < 1u || hostStack.count > MAX_MEDIUM_STACK_CAPACITY || airStack.count > MAX_MEDIUM_STACK_CAPACITY ||
        boundaryInstanceID == kInvalidIndex || boundaryMedium.mediumID == kInvalidIndex || !IsPathFinite(NoW) || abs(NoW) <= EPSILON_MIN)
        return false;

    // Pure boundaries inherit the current host IOR
    boundaryMedium.ior = hostStack.Current().medium.ior;
    if (!IsPathFinite(boundaryMedium.ior) || boundaryMedium.ior <= 0.0)
        return false;

    if ((mediumFlags & MEDIUM_FLAG_AIR_CONTRIBUTOR) != 0u)
    {
        if (NoW > 0.0)
        {
            MediumEntry entry;
            entry.boundaryInstanceID = boundaryInstanceID;
            entry.medium = boundaryMedium;

            return airStack.TryAdd(entry);
        }
        else
        {
            return airStack.TryRemove(boundaryInstanceID);
        }
    }

    // Preserve the already implemented nested replacement-medium transition
    BoundaryMediumPair pair;
    if (!hostStack.TryResolveBoundaryMediums(boundaryInstanceID, boundaryMedium, NoW, pair))
        return false;

    if (pair.isEntering != 0u)
    {
        MediumEntry entry;
        entry.boundaryInstanceID = boundaryInstanceID;
        entry.medium = pair.mediumT;
        return hostStack.TryPush(entry);
    }
    return hostStack.TryPop(boundaryInstanceID);
}

struct ShadowPayload
{
    uint visible;
    uint alphaSeed;
};


struct PathContribution
{
    float3 diffuse;
    float3 specular;
    float3 transmission;
};

PathContribution ZeroPathContribution()
{
    PathContribution contribution;
    contribution.diffuse      = float3(0.0, 0.0, 0.0);
    contribution.specular     = float3(0.0, 0.0, 0.0);
    contribution.transmission = float3(0.0, 0.0, 0.0);
    return contribution;
}

struct PathBSDFSample
{
    float3 wi;
    uint   flags;
    float3 weight;      // Sampled-history continuation estimator C_H / q_H.
    uint   valid;
    uint   lobe;
    uint   isDelta;
    uint   attempted;
    float  rrEtaScale;
};

struct RayCone
{
    float radius;
    float tanHalfAngle;
};


bool IsPathFinite3(float3 v)
{
    return all(v == v) && all(abs(v) < float3(3.402823e+38, 3.402823e+38, 3.402823e+38));
}

// MIS weight
float PowerHeuristic(float pdfA, float pdfB)
{
    pdfA = (IsPathFinite(pdfA) && pdfA > 0.0) ? pdfA : 0.0;
    pdfB = (IsPathFinite(pdfB) && pdfB > 0.0) ? pdfB : 0.0;
    float maxPDF = max(pdfA, pdfB);
    if (maxPDF <= 0.0)
        return 0.0;

    float a = pdfA / maxPDF;
    float b = pdfB / maxPDF;
    float a2 = a * a;
    float b2 = b * b;
    return a2 / (a2 + b2);
}

float CalculateMISWeight(float prevMarginalPDF, float pdfLight, uint wasDelta)
{
    if (wasDelta != 0)
        return 1.0;

    if (!IsPathFinite(pdfLight) || pdfLight <= 0.0)
        return 1.0;

    if (!IsPathFinite(prevMarginalPDF) || prevMarginalPDF <= 0.0)
        return 0.0;

    return PowerHeuristic(prevMarginalPDF, pdfLight);
}

// materialTextures = GetResource(buffers.materialTextures)
float3 ReadBaseColor(StructuredBuffer< MaterialTextureData > materialTextures, MaterialData mat, float2 uv, float2 ddxUV, float2 ddyUV)
{
    float3 albedo = mat.tint;

    float4 textureValue;
    uint channel;
    if (SampleMaterialTextureGrad(
            materialTextures,
            mat,
            eMaterialTextureSemantic_BaseColor,
            uv,
            ddxUV,
            ddyUV,
            textureValue,
            channel))
    {
        albedo *= textureValue.rgb;
    }

    return max(albedo, float3(0.0, 0.0, 0.0));
}

float ReadOpacityLevel(StructuredBuffer< MaterialTextureData > materialTextures, MaterialData mat, float2 uv)
{
    float opacity = mat.opacity;

    float4 textureValue;
    uint channel;
    if (SampleMaterialTextureLevel(
            materialTextures,
            mat,
            eMaterialTextureSemantic_Opacity,
            uv,
            textureValue,
            channel))
    {
        opacity *= SelectMaterialTextureScalar(textureValue, channel);
    }
    return saturate(opacity);
}



#pragma once
#include "Common/Math.slangh"

float sq(float x)
{
    return x * x;
}

float max2(float2 v)
{
    return max(v.x, v.y);
}

float max3(float3 v)
{
    return max(max(v.x, v.y), v.z);
}

float mean3(float3 v)
{
    return (v.x + v.y + v.z) / 3.0;
}

bool IsPathFinite(float v)
{
    return (v == v) && abs(v) < 3.402823e+38;
}

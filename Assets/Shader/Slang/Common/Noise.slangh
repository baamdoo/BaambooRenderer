#pragma once

// MurmurHash (https://sites.google.com/site/murmurhash/) of a 2D unsigned integer
uint hash2D(uint2 p, uint seed)
{
    const uint m = 0x5bd1e995u;
    uint hash = seed;

    uint k = p.x;
    k *= m;
    k ^= k >> 24;
    k *= m;
    hash *= m;
    hash ^= k;

    k = p.y;
    k *= m;
    k ^= k >> 24;
    k *= m;
    hash *= m;
    hash ^= k;

    hash ^= hash >> 13;
    hash *= m;
    hash ^= hash >> 15;
    return hash;
}

float valueNoiseHash2D(float2 p)
{
    const uint2 ip = uint2(int2(p));
    const uint  h  = hash2D(ip, 0x9E3779B9u);
    return -1.0 + 2.0 * (float(h) * (1.0 / 4294967296.0));
}

// Value noise with analytic derivatives (iq "noised"): (value in [-1, 1], d/dx, d/dy)
float3 valueNoiseDeriv2D(float2 p)
{
    const float2 i = floor(p);
    const float2 f = frac(p);

    const float2 u  = f * f * f * (f * (f * 6.0 - 15.0) + 10.0); // quintic smoothstep
    const float2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);      // its derivative

    const float a = valueNoiseHash2D(i + float2(0.0, 0.0));
    const float b = valueNoiseHash2D(i + float2(1.0, 0.0));
    const float c = valueNoiseHash2D(i + float2(0.0, 1.0));
    const float d = valueNoiseHash2D(i + float2(1.0, 1.0));

    const float k0 = a;
    const float k1 = b - a;
    const float k2 = c - a;
    const float k4 = a - b - c + d;

    const float  val = k0 + k1 * u.x + k2 * u.y + k4 * u.x * u.y;
    const float2 der = du * (float2(k1, k2) + k4 * float2(u.y, u.x));
    return float3(val, der);
}

static const float UIF = 1.0 / float(0xffffffffu);

// MurmurHash of a 3D unsigned integer
uint hash3D(uint3 p, uint seed)
{
    const uint m = 0x5bd1e995u;
    uint hash = seed;

    uint k = p.x;
    k *= m;
    k ^= k >> 24;
    k *= m;
    hash *= m;
    hash ^= k;

    k = p.y;
    k *= m;
    k ^= k >> 24;
    k *= m;
    hash *= m;
    hash ^= k;

    k = p.z;
    k *= m;
    k ^= k >> 24;
    k *= m;
    hash *= m;
    hash ^= k;

    hash ^= hash >> 13;
    hash *= m;
    hash ^= hash >> 15;
    return hash;
}
